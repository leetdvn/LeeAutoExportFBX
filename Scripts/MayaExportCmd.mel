//Check Plugins
if(!`pluginInfo -q -l "fbxmaya"`)
	loadPlugin "fbxmaya";

global proc MassFbxExp(){
	if(!`objExists "MassExport"`){
		print("not found MassExport\n");
		return;
	}
	string $MassExp[] = `editDisplayLayerMembers -q MassExport`;
	print("MassFbxNumber  : "  + size($MassExp) + "\n");
	for($i = 0 ; $i < size($MassExp) ; ++$i){
		select -cl;
		select -r $MassExp[$i];
		string $exp = "%1" + $MassExp[$i] + ".fbx" ;
		file -force -options "v=0" -type "FBX export" -pr -es $exp;
		if(`file -q -ex $exp`)
			print("Exported  : " + $exp + "\n");
	};
}

